{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prisma",
  "version": "0.1.0",
  "identifier": "com.prisma.lighting",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "Prisma",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
