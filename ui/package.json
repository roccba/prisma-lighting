{
  "name": "prisma-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prisma patch-editor frontend (React + Canvas).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "podman run --rm -v \"$PWD\":/ui:z -w /ui --ipc=host mcr.microsoft.com/playwright:v1.65.1-noble npx playwright test --grep-invert @screenshot",
    "test:e2e:screens": "podman run --rm -v \"$PWD\":/ui:z -w /ui --ipc=host mcr.microsoft.com/playwright:v1.65.1-noble npx playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
